  margin: 4px 0 0;
  font-size: 20px;
}

.summary-product {
  margin-bottom: 18px;
}

.prod-chip {
  display: inline-block;
  background: rgba(245, 158, 11, 0.15);
  color: var(--accent-gold);
  font-weight: 700;
  font-size: 12px;
  padding: 3px 8px;
  border-radius: 4px;
  margin-bottom: 4px;
}

.summary-product p {
  font-size: 12px;
  color: var(--text-muted);
  margin: 0;
}

/* Оповещение об индивидуальном расчете */
.individual-alert-panel {
  background: rgba(245, 158, 11, 0.08);
  border: 1px solid var(--accent-gold);
  border-radius: 8px;
  padding: 14px;
  margin-bottom: 18px;
}

.alert-head {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--accent-gold);
  font-size: 13px;
  margin-bottom: 6px;
}

.individual-alert-panel p {
  font-size: 12px;
  color: var(--text-primary);
  margin: 0 0 10px;
  line-height: 1.4;
}

.reasons-list {
  font-size: 11px;
  color: var(--text-muted);
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.summary-figures {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-bottom: 20px;
  border-bottom: 1px solid var(--border-color);
  padding-bottom: 18px;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.price-row span {
  display: block;
  font-size: 13px;
}

.price-row small {
  display: block;
  font-size: 11px;
  color: var(--text-muted);
}

.price-row strong {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 19px;
}

.price-row strong.gold-text {
  color: var(--accent-gold);
}

.price-row.ai-row {
  font-size: 12px;
  color: var(--text-muted);
}

.summary-breakdown {
  margin-bottom: 20px;
}

.breakdown-title {
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 8px;
}

.breakdown-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 12px;
}

.breakdown-list li {
  display: flex;
  justify-content: space-between;
}

.summary-actions {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.full-width {
  width: 100%;
  text-align: center;
}

.reset-link {
  background: none;
  border: none;
  color: var(--text-muted);
  font-size: 12px;
  cursor: pointer;
  text-decoration: underline;
  padding: 4px;
}

.reset-link:hover {
  color: var(--text-primary);
}

.disclaimer-text {
  font-size: 11px;
  color: var(--text-muted);
  line-height: 1.4;
  margin-top: 14px;
}

/* Модальное окно лида */
.lead-modal {
  max-width: 540px;
}

.checkbox-kp {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  cursor: pointer;
  margin: 12px 0;
}

.warning-note {
  background: rgba(245, 158, 11, 0.1);
  border-left: 3px solid var(--accent-gold);
  padding: 10px 14px;
  font-size: 12px;
  color: var(--text-primary);
  margin-bottom: 12px;
}

.lead-success-box {
  text-align: center;
  padding: 24px 0;
}

.lead-success-box h4 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 20px;
  margin: 14px 0 8px;
}

.lead-success-box p {
  color: var(--text-muted);
  font-size: 14px;
  margin-bottom: 24px;
}

/* Базовый сброс зазоров */
*, *::before, *::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 0;
  background-color: var(--bg-main);
  color: var(--text-primary);
}

/* ========================================================
   СТЕППЕР ШАГОВ (WIZARD STEPPER)
   ======================================================== */

.wizard-stepper {
  display: flex;
  gap: 12px;
  margin-bottom: 24px;
  overflow-x: auto;
  padding-bottom: 4px;
}

.wizard-step-item {
  flex: 1;
  min-width: 140px;
  display: flex;
  align-items: center;
  gap: 12px;
  background-color: var(--bg-card);
  border: 1px solid var(--border-color);
  padding: 12px 16px;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.wizard-step-item:hover {
  border-color: var(--accent-gold);
}

.wizard-step-item.active {
  border-color: var(--accent-gold);
  background-color: var(--bg-card-hover);
  box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.2);
}

.wizard-step-item.passed .wizard-step-badge {
  background: var(--accent-gold);
  color: #0F172A;
}

.wizard-step-badge {
  width: 28px;
  height: 28px;
  border-radius: 6px;
  background: rgba(148, 163, 184, 0.15);
  color: var(--text-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 700;
  font-size: 12px;
  flex-shrink: 0;
}

.wizard-step-item.active .wizard-step-badge {
  background: rgba(245, 158, 11, 0.2);
  color: var(--accent-gold);
  border: 1px solid var(--accent-gold);
}

.wizard-step-text {
  display: flex;
  flex-direction: column;
}

.step-label {
  font-size: 10px;
  text-transform: uppercase;
  color: var(--text-muted);
  letter-spacing: 0.05em;
}

.step-name {
  font-size: 13px;
  color: var(--text-primary);
}

.wizard-controls {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24px;
  padding-top: 16px;
  border-top: 1px solid var(--border-color);
}

/* ========================================================
   СТИЛИ МОДАЛЬНОГО ОКНА И ПОЛЕЙ ВВОДА (FIX СКРИНШОТА)
   ======================================================== */

.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.78);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 20px;
}

.modal.lead-modal {
  background-color: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 32px;
  width: 100%;
  max-width: 580px;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  color: var(--text-primary);
}

.modal-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24px;
}

.modal-head h3 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 22px;
  margin: 4px 0 8px;
}

.modal-head p {
  font-size: 13px;
  color: var(--text-muted);
  margin: 0;
  line-height: 1.4;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-bottom: 16px;
}

@media (max-width: 540px) {
  .form-grid {
    grid-template-columns: 1fr;
  }
}

.field-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
  text-align: left;
}

.field-group.full-width-field {
  margin-bottom: 16px;
}

.field-label {
  font-size: 13px;
  font-weight: 500;
  color: var(--text-primary);
}

.form-input,
.form-textarea {
  width: 100%;
  background-color: var(--bg-card-hover);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  border-radius: 6px;
  padding: 10px 14px;
  font-size: 14px;
  font-family: inherit;
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.form-input:focus,
.form-textarea:focus {
  border-color: var(--accent-gold);
  box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.2);
}

.form-textarea {
  resize: vertical;
  min-height: 70px;
}

.checkbox-kp {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  cursor: pointer;
  margin-bottom: 18px;
  color: var(--text-primary);
}

.checkbox-kp input[type="checkbox"] {
  width: 16px;
  height: 16px;
  accent-color: var(--accent-gold);
  cursor: pointer;
}

.warning-note {
  background: rgba(245, 158, 11, 0.1);
  border-left: 3px solid var(--accent-gold);
  padding: 10px 14px;
  font-size: 12px;
  color: var(--text-primary);
  margin-bottom: 18px;
  border-radius: 0 6px 6px 0;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  margin-top: 20px;
}

.modal-actions button {
  padding: 10px 20px;
  border-radius: 6px;
  font-size: 14px;
  cursor: pointer;
}

.lead-success-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 24px 0 12px;
  gap: 12px;
}

.lead-success-box h4 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 20px;
  margin: 0;
}

.lead-success-box p {
  color: var(--text-muted);
  font-size: 14px;
  max-width: 400px;
  margin: 0 0 16px;
}

/* ========================================================
   CINEMATIC NOVA LANDING (BEACON AXIS THEME)
   ======================================================== */

:root {
  --color-midnight: #0F172A;
  --color-slate-dark: #1E293B;
  --color-slate-mid: #334155;
  --color-silver: #94A3B8;
  --color-mist: #E2E8F0;
  --color-white: #FFFFFF;
  --color-nova-gold: #F59E0B;
  --color-gold-light: #FEF3C7;
}

/* Переменные тёмной темы (по умолчанию) */
.landing-cinematic.theme-dark {
  --bg-main: #0B1120;
  --bg-card: #1E293B;
  --bg-card-hover: #26354D;
  --border-color: rgba(148, 163, 184, 0.2);
  --text-primary: #FFFFFF;
  --text-muted: #94A3B8;
  --accent-gold: #F59E0B;
  --curve-color: rgba(56, 189, 248, 0.35);
  --curve-glow: rgba(56, 189, 248, 0.15);
}

/* Переменные светлой темы */
.landing-cinematic.theme-light {
  --bg-main: #F1F5F9;
  --bg-card: #FFFFFF;
  --bg-card-hover: #F8FAFC;
  --border-color: #CBD5E1;
  --text-primary: #0F172A;
  --text-muted: #64748B;
  --accent-gold: #D97706;
  --curve-color: rgba(245, 158, 11, 0.4);
  --curve-glow: rgba(245, 158, 11, 0.15);
}

.landing-cinematic {
  min-height: 100vh;
  background-color: var(--bg-main);
  color: var(--text-primary);
  font-family: 'DM Sans', system-ui, -apple-system, sans-serif;
  position: relative;
  overflow-x: hidden;
  transition: background-color 0.3s ease, color 0.3s ease;
}

/* Логотип lockup */
.nova-brand-lockup {
  display: flex;
  align-items: center;
  gap: 12px;
}

.nova-brand-text {
  display: flex;
  align-items: baseline;
  gap: 6px;
  font-family: 'Space Grotesk', serif, sans-serif;
  letter-spacing: 0.18em;
  font-weight: 700;
  font-size: 19px;
}

.brand-word {
  color: var(--text-primary);
}

.brand-word-ai {
  color: var(--text-primary);
}

.letter-a {
  color: var(--accent-gold);
}

/* Хедер */
.cinematic-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24px 64px;
  position: relative;
  z-index: 20;
}

.header-nav {
  display: flex;
  gap: 36px;
}

.header-nav a {
  color: var(--text-muted);
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  transition: color 0.2s;
  position: relative;
}

.header-nav a:hover,
.header-nav a.active {
  color: var(--accent-gold);
}

.header-nav a.active::after {
  content: '';
  position: absolute;
  bottom: -6px;
  left: 0;
  right: 0;
  height: 2px;
  background-color: var(--accent-gold);
  border-radius: 2px;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 16px;
}

.lang-switcher {
  display: flex;
  align-items: center;
  gap: 4px;
  border: 1px solid var(--border-color);
  padding: 6px 12px;
  border-radius: 20px;
  font-size: 13px;
  color: var(--text-muted);
  cursor: pointer;
}

.theme-toggle-btn {
  background: transparent;
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s;
}

.theme-toggle-btn:hover {
  border-color: var(--accent-gold);
  color: var(--accent-gold);
}

.btn-telegram-outline {
  display: flex;
  align-items: center;
  gap: 8px;
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  text-decoration: none;
  padding: 8px 18px;
  border-radius: 20px;
  font-size: 14px;
  font-weight: 500;
  transition: all 0.2s;
}

.btn-telegram-outline:hover {
  border-color: var(--accent-gold);
  color: var(--accent-gold);
}

/* ================= HERO СЕКЦИЯ ================= */
.cinematic-hero {
  position: relative;
  min-height: 86vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 40px 64px 0;
  overflow: hidden;
}

/* Фоновые звёзды */
.space-particles {
  position: absolute;
  inset: 0;
  background-image: 
    radial-gradient(1px 1px at 20px 30px, #ffffff, rgba(0,0,0,0)),
    radial-gradient(1.5px 1.5px at 150px 80px, #ffffff, rgba(0,0,0,0)),
    radial-gradient(1px 1px at 320px 240px, #FEF3C7, rgba(0,0,0,0)),
    radial-gradient(1px 1px at 600px 180px, #ffffff, rgba(0,0,0,0)),
    radial-gradient(1.5px 1.5px at 850px 90px, #F59E0B, rgba(0,0,0,0)),
    radial-gradient(1px 1px at 1100px 210px, #ffffff, rgba(0,0,0,0));
  background-repeat: repeat;
  background-size: 1200px 600px;
  opacity: 0.45;
  pointer-events: none;
}

/* Светящаяся кривизна планеты (как на скриншоте) */
.planet-horizon-curve {
  position: absolute;
  bottom: -400px;
  left: 20%;
  right: -250px;
  height: 800px;
  border-radius: 50%;
  border-top: 2px solid var(--curve-color);
  box-shadow: 0 -16px 80px var(--curve-glow), inset 0 20px 60px rgba(15, 23, 42, 0.8);
  pointer-events: none;
  z-index: 1;
}

.hero-content-grid {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  align-items: center;
  position: relative;
  z-index: 10;
  margin-top: 20px;
}

@media (max-width: 1024px) {
  .hero-content-grid {
    grid-template-columns: 1fr;
  }
  .hero-visual-block {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }
}

.hero-kicker-caps {
  display: block;
  font-size: 12px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--text-muted);
  font-weight: 600;
  margin-bottom: 16px;
}

.hero-giant-title {
  font-family: 'Space Grotesk', serif, sans-serif;
  font-size: 72px;
  letter-spacing: 0.12em;
  font-weight: 700;
  margin: 0 0 16px;
  line-height: 1;
  color: var(--text-primary);
}

.gold-letter {
  color: var(--accent-gold);
}

.hero-subheading {
  font-size: 28px;
  font-weight: 500;
  line-height: 1.35;
  margin: 0 0 20px;
  max-width: 620px;
  color: var(--text-primary);
}

.hero-description {
  font-size: 15px;
  line-height: 1.6;
  color: var(--text-muted);
  max-width: 540px;
  margin: 0 0 36px;
}

.hero-actions-row {
  display: flex;
  align-items: center;
  gap: 24px;
}

/* Кнопка "Собрать конфигурацию" */
.btn-hero-primary-gold {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  background-color: var(--accent-gold);
  color: #0F172A;
  font-weight: 700;
  font-size: 15px;
  padding: 14px 28px;
  border-radius: 28px;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
  box-shadow: 0 4px 20px rgba(245, 158, 11, 0.3);
}

.btn-hero-primary-gold:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 28px rgba(245, 158, 11, 0.45);
}

.btn-icon {
  font-size: 18px;
  font-weight: 700;
}

.btn-hero-link-arrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--text-primary);
  text-decoration: none;
  font-size: 15px;
  font-weight: 600;
  transition: gap 0.2s, color 0.2s;
}

.btn-hero-link-arrow:hover {
  color: var(--accent-gold);
  gap: 12px;
}

/* Правый арт */
.hero-visual-block {
  display: flex;
  justify-content: flex-end;
  position: relative;
}

.beacon-wrapper {
  animation: floatOrb 7s ease-in-out infinite;
  filter: drop-shadow(0 0 50px rgba(245, 158, 11, 0.25));
}

@keyframes floatOrb {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12px);
  }
}

/* ================= НИЖНЯЯ ПАНЕЛЬ ИЗ ТРЕХ КОЛОНОК ================= */
.hero-ticker-bar {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid var(--border-color);
  margin-top: 48px;
  position: relative;
  z-index: 10;
  backdrop-filter: blur(8px);
}

@media (max-width: 860px) {
  .hero-ticker-bar {
    grid-template-columns: 1fr;
  }
}

.ticker-item {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 24px 20px;
  border-right: 1px solid var(--border-color);
}

.ticker-item:last-child {
  border-right: none;
}

.ticker-icon {
  color: var(--accent-gold);
  margin-top: 2px;
}

.ticker-text strong {
  display: block;
  font-size: 15px;
  margin-bottom: 4px;
  color: var(--text-primary);
}

.ticker-text p {
  margin: 0;
  font-size: 13px;
  color: var(--text-muted);
  line-height: 1.4;
}

/* ================= СЕКЦИЯ ПРОДУКТОВ НА ЛЕНДИНГЕ ================= */
.landing-section {
  padding: 80px 64px;
  position: relative;
  z-index: 10;
}

.section-head-center {
  text-align: center;
  max-width: 640px;
  margin: 0 auto 48px;
}

.section-head-center h2 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 32px;
  margin: 8px 0 12px;
}

.section-head-center p {
  color: var(--text-muted);
  font-size: 15px;
}

.cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 28px;
}

.landing-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 14px;
  padding: 32px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: all 0.25s ease;
}

.landing-card:hover {
  border-color: var(--accent-gold);
  transform: translateY(-4px);
}

.landing-card.featured {
  border-color: rgba(245, 158, 11, 0.4);
  box-shadow: 0 8px 30px rgba(245, 158, 11, 0.08);
}

.card-badge {
  display: inline-block;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--text-muted);
  background: rgba(148, 163, 184, 0.1);
  padding: 4px 10px;
  border-radius: 12px;
  margin-bottom: 14px;
}

.card-badge.featured {
  color: var(--accent-gold);
  background: rgba(245, 158, 11, 0.15);
}

.landing-card h3 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 22px;
  margin: 0 0 12px;
}

.landing-card p {
  color: var(--text-muted);
  font-size: 14px;
  line-height: 1.5;
  margin-bottom: 24px;
}

.card-bottom {
  border-top: 1px solid var(--border-color);
  padding-top: 20px;
}

.card-price {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 20px;
  font-weight: 700;
  color: var(--accent-gold);
  margin-bottom: 16px;
}

.btn-card-gold {
  width: 100%;
  padding: 12px;
  border-radius: 8px;
  border: 1px solid var(--border-color);
  background-color: var(--bg-card-hover);
  color: var(--text-primary);
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.2s;
}

.btn-card-gold:hover {
  background-color: var(--accent-gold);
  color: #0F172A;
  border-color: var(--accent-gold);
}

/* Футер */
.cinematic-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32px 64px;
  border-top: 1px solid var(--border-color);
  font-size: 13px;
  color: var(--text-muted);
  position: relative;
  z-index: 10;
}

@media (max-width: 768px) {
  .cinematic-header,
  .cinematic-hero,
  .landing-section,
  .cinematic-footer {
    padding-left: 24px;
    padding-right: 24px;
  }
  .header-nav {
    display: none;
  }
  .hero-giant-title {
    font-size: 48px;
  }
}
