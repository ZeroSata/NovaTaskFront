import { useState, useEffect, useMemo, type FormEvent } from 'react'
import {
  defaultPricingConfig,
  loadPricingConfig,
} from '../lib/pricingConfig'
import { calculatePrice } from '../lib/pricingCalculator'
import type {
  ConstructorState,
  PricingConfig,
  LeadSubmission,
} from '../lib/constructorTypes'
import {
  CheckCircle2,
  CircleAlert,
  RefreshCw,
} from '../components/Icons'

const STORAGE_KEY = 'nova_constructor_state_v1'

const initialDefaultState: ConstructorState = {
  productId: 'prod-single',
  featureIds: ['ft-text-gen', 'ft-doc-search'],
  integrationIds: ['int-tg-bot'],
  employeeCount: 2,
  storageGb: 10,
  manualDocProcessing: false,
  customImport: false,
  largeArchiveRecognition: false,
  publishingAssistance: false,
  aiPaymentMode: 'shared-balance',
  clientComment: '',
}

const STEPS = [
  { id: 1, title: 'Формат', label: 'Продукт' },
  { id: 2, title: 'Функции', label: 'Возможности' },
  { id: 3, title: 'Каналы', label: 'Интеграции' },
  { id: 4, title: 'Ресурсы', label: 'Доступы & База' },
  { id: 5, title: 'AI-бюджет', label: 'Финальный план' },
]

export function ConstructorPage({ onBackToHome }: { onBackToHome: () => void }) {
  const [currentStep, setCurrentStep] = useState(1)
  const [config, setConfig] = useState<PricingConfig>(defaultPricingConfig)

  const [state, setState] = useState<ConstructorState>(() => {
    try {
      const saved = localStorage.getItem(STORAGE_KEY)
      if (saved) return JSON.parse(saved)
    } catch {}
    return initialDefaultState
  })

  // Модальное окно лида / КП
  const [leadModalOpen, setLeadModalOpen] = useState(false)
  const [leadSuccess, setLeadSuccess] = useState(false)
  const [leadSubmitting, setLeadSubmitting] = useState(false)
  const [leadError, setLeadError] = useState('')
  const [contactName, setContactName] = useState('')
  const [contactPhone, setContactPhone] = useState('')
  const [contactEmail, setContactEmail] = useState('')
  const [companyName, setCompanyName] = useState('')
  const [wantsKpDownload, setWantsKpDownload] = useState(true)

  useEffect(() => {
    loadPricingConfig().then(setConfig)
  }, [])

  useEffect(() => {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state))
    } catch {}
  }, [state])

  const pricing = useMemo(() => calculatePrice(state, config), [state, config])
  const selectedProduct = config.products.find(p => p.id === state.productId) ?? config.products[0]

  const handleReset = () => {
    if (window.confirm('Сбросить выбранные параметры к начальным значениям?')) {
      setState(initialDefaultState)
      setCurrentStep(1)
      localStorage.removeItem(STORAGE_KEY)
    }
  }

  const toggleFeature = (fid: string) => {
    setState(prev => ({
      ...prev,
      featureIds: prev.featureIds.includes(fid)
        ? prev.featureIds.filter(id => id !== fid)
        : [...prev.featureIds, fid],
    }))
  }

  const toggleIntegration = (iid: string) => {
    setState(prev => ({
      ...prev,
      integrationIds: prev.integrationIds.includes(iid)
        ? prev.integrationIds.filter(id => id !== iid)
        : [...prev.integrationIds, iid],
    }))
  }

  const handleLeadSubmit = async (e: FormEvent) => {
    e.preventDefault()
    setLeadError('')
    setLeadSubmitting(true)

    const payload: LeadSubmission = {
      contactName,
      contactPhone,
      contactEmail,
      companyName,
      wantsKpDownload,
      state,
      pricingSummary: pricing,
    }

    try {
      const base = import.meta.env.VITE_API_URL ?? '/api'
      const res = await fetch(`${base}/construct/leads`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      }).catch(() => null)

      if (res && !res.ok) {
        throw new Error('Не удалось отправить заявку. Попробуйте еще раз.')
      }

      setLeadSuccess(true)
    } catch (err) {
      setLeadError(err instanceof Error ? err.message : 'Ошибка отправки')
    } finally {
      setLeadSubmitting(false)
    }
  }

  return (
    <div className="constructor-page">
      {/* Шапка */}
      <header className="construct-header">
        <div className="construct-header-left">
          <button className="back-link-btn" onClick={onBackToHome}>
            ← На главную
          </button>
          <div>
            <div className="construct-eyebrow">NOVA / STEP-BY-STEP BUILDER</div>
            <h1 className="construct-title">Конструктор AI-сервисов</h1>
          </div>
        </div>

        <div className="construct-header-actions">
          <button className="secondary-button" onClick={handleReset} title="Сбросить конфигурацию">
            <RefreshCw size={15} /> Сбросить
          </button>
          <button className="primary-button gold-btn" onClick={() => setLeadModalOpen(true)}>
            Оформить заявку / КП
          </button>
        </div>
      </header>

      {/* Полоса шагов (Wizard Stepper) */}
      <div className="wizard-stepper">
        {STEPS.map(s => {
          const isActive = currentStep === s.id
          const isPassed = currentStep > s.id
          return (
            <div
              key={s.id}
              className={`wizard-step-item ${isActive ? 'active' : ''} ${isPassed ? 'passed' : ''}`}
              onClick={() => setCurrentStep(s.id)}
            >
              <div className="wizard-step-badge">{isPassed ? '✓' : `0${s.id}`}</div>
              <div className="wizard-step-text">
                <span className="step-label">{s.title}</span>
                <strong className="step-name">{s.label}</strong>
              </div>
            </div>
          )
        })}
      </div>

      {/* Основная сетка: активный шаг слева + плавающий Sidebar справа */}
      <div className="construct-layout">
        <div className="construct-main">
          {/* ШАГ 1: ВЫБОР ПРОДУКТА */}
          {currentStep === 1 && (
            <section className="calc-section">
              <div className="calc-section-head">
                <span className="step-num">01</span>
                <div>
                  <h2>Формат и тип решения</h2>
                  <p>Выберите архитектуру под масштаб задач вашей команды.</p>
                </div>
              </div>

              <div className="product-cards-grid">
                {config.products.map(prod => {
                  const isSelected = prod.id === state.productId
                  return (
                    <div
                      key={prod.id}
                      className={`product-select-card ${isSelected ? 'active' : ''}`}
                      onClick={() => setState(s => ({ ...s, productId: prod.id }))}
                    >
                      {prod.badge && <span className="product-badge">{prod.badge}</span>}
                      <div className="prod-title">{prod.title}</div>
                      <div className="prod-sub">{prod.subtitle}</div>
                      <div className="prod-desc">{prod.description}</div>
                      <div className="prod-prices">
                        <div className="prod-price-item">
                          <span>Запуск</span>
                          <strong>{prod.baseSetupPrice.toLocaleString('ru-RU')} ₽</strong>
                        </div>
                        <div className="prod-price-item">
                          <span>Поддержка</span>
                          <strong>{prod.baseMonthlyPrice.toLocaleString('ru-RU')} ₽/мес</strong>
                        </div>
                      </div>
                    </div>
                  )
                })}
              </div>
            </section>
          )}

          {/* ШАГ 2: ФУНКЦИОНАЛЬНОСТЬ */}
          {currentStep === 2 && (
            <section className="calc-section">
              <div className="calc-section-head">
                <span className="step-num">02</span>
                <div>
                  <h2>Функциональные возможности</h2>
                  <p>Выберите базовые и специализированные алгоритмы работы ассистента.</p>
                </div>
              </div>

              <div className="options-grid">
                {config.features.map(feat => {
                  const isChecked = state.featureIds.includes(feat.id)
                  const isAllowed = selectedProduct.allowedFeatureIds.includes(feat.id)

                  return (
                    <label
                      key={feat.id}
                      className={`option-check-card ${isChecked ? 'checked' : ''} ${!isAllowed ? 'disabled' : ''}`}
                    >
                      <input
                        type="checkbox"
                        checked={isChecked}
                        disabled={!isAllowed}
                        onChange={() => toggleFeature(feat.id)}
                      />
                      <div className="check-card-body">
                        <div className="check-card-title">
                          <strong>{feat.title}</strong>
                          {feat.requiresIndividualEstimate && (
                            <span className="pill-individual">Индивидуально</span>
                          )}
                          {feat.isHardScenario && (
                            <span className="pill-hard">Сложный сценарий</span>
                          )}
                        </div>
                        <p>{feat.description}</p>
                        <div className="check-card-meta">
                          {feat.setupPrice > 0 && (
                            <span>+ {feat.setupPrice.toLocaleString('ru-RU')} ₽ запуск</span>
                          )}
                          {feat.monthlyPrice > 0 && (
                            <span>+ {feat.monthlyPrice.toLocaleString('ru-RU')} ₽/мес</span>
                          )}
                          {!isAllowed && <span className="warning-text">Недоступно в этом тарифе</span>}
                        </div>
                      </div>
                    </label>
                  )
                })}
              </div>
            </section>
          )}

          {/* ШАГ 3: ИНТЕГРАЦИИ */}
          {currentStep === 3 && (
            <section className="calc-section">
              <div className="calc-section-head">
                <span className="step-num">03</span>
                <div>
                  <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
                    <h2>Каналы связи и интеграции</h2>
                    <span className="count-pill">{state.integrationIds.length} выбрано</span>
                  </div>
                  <p>
                    Каждая точка подключения рассчитывается отдельно. Выбор более {config.maxAutoIntegrationsThreshold} интеграций
                    переводит проект в индивидуальный расчёт архитектуры.
                  </p>
                </div>
              </div>

              <div className="integrations-list">
                {config.integrations.map(integ => {
                  const isChecked = state.integrationIds.includes(integ.id)
                  const isIndividual = integ.level === 'individual' || integ.requiresIndividualEstimate

                  return (
                    <div
                      key={integ.id}
                      className={`integration-row ${isChecked ? 'active' : ''}`}
                      onClick={() => toggleIntegration(integ.id)}
                    >
                      <input
                        type="checkbox"
                        checked={isChecked}
                        onChange={() => {}}
                      />
                      <div className="integ-info">
                        <div className="integ-top">
                          <strong>{integ.title}</strong>
                          <span className={`level-tag level-${integ.level}`}>
                            {typeof integ.level === 'number' ? `Уровень ${integ.level}` : 'Индивидуально'}
                          </span>
                          {integ.hasReadyConnector ? (
                            <span className="connector-tag">Готовый коннектор</span>
                          ) : (
                            <span className="connector-tag custom">Кастомная разработка</span>
                          )}
                        </div>
                        <p>{integ.description}</p>
                        {integ.restrictionsNote && (
                          <div className="integ-restriction">Ограничение: {integ.restrictionsNote}</div>
                        )}
                      </div>

                      <div className="integ-pricing">
                        {isIndividual ? (
                          <span className="pill-individual">Индивидуальный расчет</span>
                        ) : (
                          <>
                            <div className="setup-cost">{integ.setupPrice.toLocaleString('ru-RU')} ₽ запуск</div>
                            {integ.monthlyPrice > 0 ? (
                              <div className="monthly-cost">+{integ.monthlyPrice.toLocaleString('ru-RU')} ₽/мес</div>
                            ) : (
                              <div className="monthly-cost free">0 ₽/мес</div>
                            )}
                          </>
                        )}
                      </div>
                    </div>
                  )
                })}
              </div>
            </section>
          )}

          {/* ШАГ 4: СОТРУДНИКИ И ХРАНИЛИЩЕ */}
          {currentStep === 4 && (
            <section className="calc-section">
              <div className="calc-section-head">
                <span className="step-num">04</span>
                <div>
                  <h2>Команда, права доступа и база знаний</h2>
                  <p>Рабочие места сотрудников, файлы документов и правила импорта данных.</p>
                </div>
              </div>

              {/* Сотрудники */}
              <div className="counter-box" style={{ marginBottom: '20px' }}>
                <div className="counter-info">
                  <strong>Рабочие места сотрудников</strong>
                  <p>
                    1 администратор включен. Дополнительные сотрудники: +{config.extraEmployeeMonthlyPrice.toLocaleString('ru-RU')} ₽/мес за место.
                  </p>
                </div>
                <div className="stepper">
                  <button
                    type="button"
                    className="step-btn"
                    disabled={state.employeeCount <= 1}
                    onClick={() => setState(s => ({ ...s, employeeCount: Math.max(1, s.employeeCount - 1) }))}
                  >
                    -
                  </button>
                  <span className="step-value">{state.employeeCount}</span>
                  <button
                    type="button"
                    className="step-btn"
                    onClick={() => setState(s => ({ ...s, employeeCount: s.employeeCount + 1 }))}
                  >
                    +
                  </button>
                </div>
              </div>

              {/* Слайдер объема */}
              <div className="slider-box">
                <div className="slider-header">
                  <div>
                    <strong>Объём выделенного хранилища документов</strong>
                    <p>В тарифе: {selectedProduct.includedStorageGb} GB. Сверх лимита: {config.extraStoragePerGbMonthlyPrice} ₽/GB в месяц.</p>
                  </div>
                  <div className="slider-indicator">{state.storageGb} GB</div>
                </div>
                <input
                  type="range"
                  min="5"
                  max="250"
                  step="5"
                  value={state.storageGb}
                  onChange={e => setState(s => ({ ...s, storageGb: Number(e.target.value) }))}
                  className="gold-range"
                />
              </div>

              {/* Чекбоксы импорта */}
              <div className="knowledge-options">
                <label className="checkbox-tile highlight-tile">
                  <input
                    type="checkbox"
                    checked={state.customImport}
                    onChange={e => setState(s => ({ ...s, customImport: e.target.checked }))}
                  />
                  <div>
                    <div className="tile-title">
                      <strong>Нестандартный импорт данных</strong>
                      <span className="pill-individual">Индивидуальный расчет</span>
                    </div>
                    <p>Импорт из закрытых СУБД, устаревших систем или неструктурированных архивов.</p>
                  </div>
                </label>

                <label className="checkbox-tile">
                  <input
                    type="checkbox"
                    checked={state.manualDocProcessing}
                    onChange={e => setState(s => ({ ...s, manualDocProcessing: e.target.checked }))}
                  />
                  <div>
                    <div className="tile-title">
                      <strong>Ручная подготовка и очистка документов методистом</strong>
                      <span>+{config.manualDocumentPrepPrice.toLocaleString('ru-RU')} ₽ запуск</span>
                    </div>
                    <p>Профессиональная разметка и чистка шумов в регламентах перед загрузкой в RAG.</p>
                  </div>
                </label>

                <label className="checkbox-tile">
                  <input
                    type="checkbox"
                    checked={state.largeArchiveRecognition}
                    onChange={e => setState(s => ({ ...s, largeArchiveRecognition: e.target.checked }))}
                  />
                  <div>
                    <div className="tile-title">
                      <strong>Распознавание больших архивов и сканов (OCR)</strong>
                      <span>+{config.archiveProcessingPrice.toLocaleString('ru-RU')} ₽ запуск</span>
                    </div>
                    <p>Потоковая обработка отсканированных PDF, таблиц и документов.</p>
                  </div>
                </label>
              </div>
            </section>
          )}

          {/* ШАГ 5: AI-БЮДЖЕТ */}
          {currentStep === 5 && (
            <section className="calc-section">
              <div className="calc-section-head">
                <span className="step-num">05</span>
                <div>
                  <h2>AI-бюджет и финализация заявки</h2>
                  <p>Выберите модель оплаты токенов нейросетей перед отправкой заявки.</p>
                </div>
              </div>

              <div className="ai-modes-grid">
                <label className={`ai-mode-card ${state.aiPaymentMode === 'shared-balance' ? 'active' : ''}`}>
                  <input
                    type="radio"
                    name="ai_mode"
                    value="shared-balance"
                    checked={state.aiPaymentMode === 'shared-balance'}
                    onChange={() => setState(s => ({ ...s, aiPaymentMode: 'shared-balance' }))}
                  />
                  <div>
                    <strong>Единый баланс Nova</strong>
                    <p>Мы берем на себя шлюзы LLM, мониторинг и выставляем закрывающие документы по факту.</p>
                  </div>
                </label>

                <label className={`ai-mode-card ${state.aiPaymentMode === 'own-account' ? 'active' : ''}`}>
                  <input
                    type="radio"
                    name="ai_mode"
                    value="own-account"
                    checked={state.aiPaymentMode === 'own-account'}
                    onChange={() => setState(s => ({ ...s, aiPaymentMode: 'own-account' }))}
                  />
                  <div>
                    <strong>Свой API-ключ</strong>
                    <p>Прямой расчёт с поставщиками (OpenAI, Anthropic). Комиссия Nova за токены: 0%.</p>
                  </div>
                </label>

                <label className={`ai-mode-card ${state.aiPaymentMode === 'later' ? 'active' : ''}`}>
                  <input
                    type="radio"
                    name="ai_mode"
                    value="later"
                    checked={state.aiPaymentMode === 'later'}
                    onChange={() => setState(s => ({ ...s, aiPaymentMode: 'later' }))}
                  />
                  <div>
                    <strong>Уточнить позже</strong>
                    <p>Выбрать модель и схему оплат в процессе технического брифинга.</p>
                  </div>
                </label>
              </div>

              <div className="notice-box">
                <CircleAlert size={18} />
                <span>
                  Точный расход AI зависит от длины промптов, размера вложенных файлов и частоты обращений сотрудников.
                </span>
              </div>
            </section>
          )}

          {/* Нижняя панель навигации (Назад / Далее) */}
          <div className="wizard-controls">
            <button
              type="button"
              className="secondary-button"
              disabled={currentStep === 1}
              onClick={() => setCurrentStep(prev => Math.max(1, prev - 1))}
            >
              ← Назад
            </button>

            {currentStep < 5 ? (
              <button
                type="button"
                className="primary-button gold-btn"
                onClick={() => setCurrentStep(prev => Math.min(5, prev + 1))}
              >
                Далее →
              </button>
            ) : (
              <button
                type="button"
                className="primary-button gold-btn"
                onClick={() => setLeadModalOpen(true)}
              >
                Оформить заявку / КП
              </button>
            )}
          </div>
        </div>

        {/* ПРАВАЯ ПАНЕЛЬ: Sticky Summary */}
        <aside className="construct-sidebar">
          <div className="summary-sticky-card">
            <div className="summary-head">
              <span className="summary-label">ИТОГОВАЯ КОНФИГУРАЦИЯ</span>
              <h3>Сводка расчёта</h3>
            </div>

            <div className="summary-product">
              <span className="prod-chip">{selectedProduct.title}</span>
              <p>{selectedProduct.subtitle}</p>
            </div>

            {pricing.requiresIndividualEstimate ? (
              <div className="individual-alert-panel">
                <div className="alert-head">
                  <CircleAlert size={18} />
                  <strong>Требуется индивидуальная оценка</strong>
                </div>
                <p>
                  Для данной конфигурации автоматический расчёт приостановлен. Оставьте заявку, чтобы получить персональную оценку.
                </p>
                <div className="reasons-list">
                  {pricing.estimateReasons.map((reason, idx) => (
                    <div key={idx} className="reason-item">• {reason}</div>
                  ))}
                </div>
              </div>
            ) : (
              <div className="summary-figures">
                <div className="price-row main-price">
                  <div>
                    <span>Разовый запуск</span>
                    <small>Настройка и коннекторы</small>
                  </div>
                  <strong>{pricing.setupPrice?.toLocaleString('ru-RU')} ₽</strong>
                </div>

                <div className="price-row main-price">
                  <div>
                    <span>Ежемесячно</span>
                    <small>Поддержка, места, серверы</small>
                  </div>
                  <strong className="gold-text">
                    {pricing.monthlyPrice?.toLocaleString('ru-RU')} ₽/мес
                  </strong>
                </div>

                {pricing.aiBudgetEstimateMonthly !== null && (
                  <div className="price-row ai-row">
                    <div>
                      <span>Ориентир AI-бюджета</span>
                      <small>Токены (по факту)</small>
                    </div>
                    <span>~{pricing.aiBudgetEstimateMonthly?.toLocaleString('ru-RU')} ₽/мес</span>
                  </div>
                )}
              </div>
            )}

            <div className="summary-breakdown">
              <div className="breakdown-title">Параметры комплекта:</div>
              <ul className="breakdown-list">
                <li>
                  <span>Интеграции</span>
                  <strong>{state.integrationIds.length} шт.</strong>
                </li>
                <li>
                  <span>Сотрудники</span>
                  <strong>{state.employeeCount} чел.</strong>
                </li>
                <li>
                  <span>Хранилище</span>
                  <strong>{state.storageGb} GB</strong>
                </li>
                {state.manualDocProcessing && <li><span>Ручная подготовка</span><strong>Да</strong></li>}
                {state.customImport && <li><span className="gold-text">Нестандартный импорт</span><strong>Да</strong></li>}
              </ul>
            </div>

            <div className="summary-actions">
              <button
                className="btn-primary-gold full-width"
                onClick={() => setLeadModalOpen(true)}
              >
                {pricing.requiresIndividualEstimate
                  ? 'Запросить индивидуальный расчёт'
                  : 'Получить КП / Оставить заявку'}
              </button>
              <button className="reset-link" onClick={handleReset}>
                Сбросить параметры
              </button>
            </div>

            <div className="disclaimer-text">
              * Предварительный расчёт не является публичной офертой. Окончательные параметры фиксируются в техническом задании.
            </div>
          </div>
        </aside>
      </div>

      {/* МОДАЛЬНОЕ ОКНО ЗАЯВКИ (ИСПРАВЛЕНО ОТОБРАЖЕНИЕ) */}
      {leadModalOpen && (
        <div
          className="modal-backdrop"
          onMouseDown={e => {
            if (e.currentTarget === e.target && !leadSubmitting) {
              setLeadModalOpen(false)
            }
          }}
        >
          <div className="modal lead-modal">
            <div className="modal-head">
              <div>
                <span className="section-label">NOVA / COMMERCIAL PROPOSAL</span>
                <h3>Оформление заявки</h3>
                <p>Менеджер зафиксирует конфигурацию и направит детальное КП с расчётом сроков запуска.</p>
              </div>
              <button
                type="button"
                className="icon-button ghost"
                onClick={() => setLeadModalOpen(false)}
              >
                ×
              </button>
            </div>

            {leadSuccess ? (
              <div className="lead-success-box">
                <CheckCircle2 size={40} color="var(--accent-gold)" />
                <h4>Заявка успешно принята!</h4>
                <p>
                  Мы зафиксировали конфигурацию для <strong>{contactEmail || contactPhone}</strong>. Наш AI-архитектор свяжется с вами в течение 30 минут.
                </p>
                <button
                  className="primary-button gold-btn"
                  onClick={() => {
                    setLeadSuccess(false)
                    setLeadModalOpen(false)
                  }}
                >
                  Вернуться в конструктор
                </button>
              </div>
            ) : (
              <form onSubmit={handleLeadSubmit} className="lead-form">
                <div className="form-grid">
                  <label className="field-group">
                    <span className="field-label">Ваше имя *</span>
                    <input
                      className="form-input"
                      required
                      placeholder="Алексей"
                      value={contactName}
                      onChange={e => setContactName(e.target.value)}
                    />
                  </label>
                  <label className="field-group">
                    <span className="field-label">Телефон / Telegram *</span>
                    <input
                      className="form-input"
                      required
                      placeholder="+7 (999) 000-00-00"
                      value={contactPhone}
                      onChange={e => setContactPhone(e.target.value)}
                    />
                  </label>
                </div>

                <div className="form-grid">
                  <label className="field-group">
                    <span className="field-label">Рабочий Email *</span>
                    <input
                      className="form-input"
                      type="email"
                      required
                      placeholder="alex@company.ru"
                      value={contactEmail}
                      onChange={e => setContactEmail(e.target.value)}
                    />
                  </label>
                  <label className="field-group">
                    <span className="field-label">Компания / Проект</span>
                    <input
                      className="form-input"
                      placeholder="ООО НОВА"
                      value={companyName}
                      onChange={e => setCompanyName(e.target.value)}
                    />
                  </label>
                </div>

                <label className="field-group full-width-field">
                  <span className="field-label">Комментарий или особые пожелания</span>
                  <textarea
                    className="form-textarea"
                    rows={3}
                    placeholder="Укажите специфику ваших баз данных, CRM или регламентов..."
                    value={state.clientComment}
                    onChange={e => setState(s => ({ ...s, clientComment: e.target.value }))}
                  />
                </label>

                <label className="checkbox-kp">
                  <input
                    type="checkbox"
                    checked={wantsKpDownload}
                    onChange={e => setWantsKpDownload(e.target.checked)}
                  />
                  <span>Сформировать PDF коммерческого предложения с расшифровкой</span>
                </label>

                {pricing.requiresIndividualEstimate && (
                  <div className="warning-note">
                    Внимание: конфигурация включает опции с индивидуальной оценкой. Мы свяжемся для проведения технического аудита.
                  </div>
                )}

                {leadError && <div className="error-box">{leadError}</div>}

                <div className="modal-actions">
                  <button
                    type="button"
                    className="secondary-button"
                    onClick={() => setLeadModalOpen(false)}
                  >
                    Отмена
                  </button>
                  <button
                    type="submit"
                    className="primary-button gold-btn"
                    disabled={leadSubmitting}
                  >
                    {leadSubmitting ? 'Отправка...' : 'Отправить конфигурацию'}
                  </button>
                </div>
              </form>
            )}
          </div>
        </div>
      )}
    </div>
  )
}
